ontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="hum" target="hitl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="arrêt / levée" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="hum" target="kill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="demande d'arrêt" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sup" target="kill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="coupe" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kill" target="rg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="lecture seule" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="sup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="SSE" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="tour"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="export" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="lf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="st" value='&lt;font color="#1f5fa8"&gt;&lt;b&gt;Bleu&lt;/b&gt;&lt;/font&gt; = agents IA qui interagissent et décident · &lt;font color="#2e7d32"&gt;&lt;b&gt;Vert&lt;/b&gt;&lt;/font&gt; = FinGuard, ce que nous construisons · &lt;b&gt;Gris&lt;/b&gt; = humains, systèmes externes ou simulés (pointillé)' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="1500" height="25" as="geometry"/></mxCell><mxCell id="prop" value='&lt;b&gt;&lt;font color="#1f5fa8"&gt;Proposer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;LLM génératif · lecture seule&lt;br&gt;émet un TransactionIntent' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="130" width="180" height="85" as="geometry"/></mxCell><mxCell id="jr" value='&lt;b&gt;&lt;font color="#1f5fa8"&gt;Juge Risque&lt;/font&gt;&lt;/b&gt;&lt;br&gt;LLM temp. 0 · classification&lt;br&gt;stricte → JudgeVerdict' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="160" height="85" as="geometry"/></mxCell><mxCell id="jc" value='&lt;b&gt;&lt;font color="#1f5fa8"&gt;Juge Conformité&lt;/font&gt;&lt;/b&gt;&lt;br&gt;LLM temp. 0 · KYC&lt;br&gt;→ JudgeVerdict' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="160" height="85" as="geometry"/></mxCell><mxCell id="exe" value="&lt;b&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;Exécuteur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;tactique · prépare l'ordre&lt;br&gt;aucun accès marché" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="130" width="170" height="85" as="geometry"/></mxCell><mxCell id="na" value="Aucun lien direct agent → agent ni agent → marché.&lt;br&gt;Identité = agent_id + mandat.&lt;br&gt;Hors ligne : agents en mode script (sans LLM)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="135" width="420" height="70" as="geometry"/></mxCell><mxCell id="gest" value="Gestionnaire&lt;br&gt;(objectif)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=none;strokeColor=#333333;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="135" width="40" height="70" as="geometry"/></mxCell><mxCell id="fg" value="FINGUARD — plan de contrôle déterministe, sans LLM" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=0;strokeColor=#2e7d32;strokeWidth=1.5;verticalAlign=top;align=right;spacingRight=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="210" y="290" width="1400" height="300" as="geometry"/></mxCell><mxCell id="fw" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Agent Firewall&lt;/font&gt;&lt;/b&gt;&lt;br&gt;entrées non fiables&lt;br&gt;anti-injection' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="pol" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Policy Engine&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ALLOW · ESCALATE · BLOCK&lt;br&gt;règles versionnées' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="quo" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Quorum pondéré&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ALLOW → autorisation&lt;br&gt;sinon → HITL' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Registre&lt;br&gt;d'autorisations&lt;/font&gt;&lt;/b&gt;&lt;br&gt;lié au hash de l'intention&lt;br&gt;expire · révocable" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="int" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Integrity Engine&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ordre = autorisation ?&lt;br&gt;sinon BLOCK' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="rg" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Risk Governor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cumul · fréquence&lt;br&gt;circuit breaker' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1230" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Passerelle&lt;br&gt;d'exécution&lt;/font&gt;&lt;/b&gt;&lt;br&gt;seul accès&lt;br&gt;au marché" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1430" y="340" width="160" height="95" as="geometry"/></mxCell><mxCell id="mand" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Mandats &amp;amp; Trust Score&lt;/font&gt;&lt;/b&gt;&lt;br&gt;plafonds · actifs · outils&lt;br&gt;quarantaine' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="475" width="220" height="85" as="geometry"/></mxCell><mxCell id="hitl" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Passerelle HITL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;interrupt() · notifie l'humain&lt;br&gt;approbation signée" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="475" width="200" height="85" as="geometry"/></mxCell><mxCell id="kill" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Kill switch&lt;/font&gt;&lt;/b&gt;&lt;br&gt;coupe l'exécution&lt;br&gt;suspend un mandat" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="475" width="200" height="85" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Journal d'audit chaîné (SHA-256)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;reçoit les événements de tous les modules&lt;br&gt;bus d'événements · fiche XAI" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="475" width="350" height="85" as="geometry"/></mxCell><mxCell id="src" value='&lt;b&gt;&lt;font color="#333333"&gt;Sources externes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;news · documents&lt;br&gt;(non fiables)' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#333333;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="170" height="95" as="geometry"/></mxCell><mxCell id="mkt" value='&lt;b&gt;&lt;font color="#333333"&gt;Marché / paiement&lt;/font&gt;&lt;/b&gt;&lt;br&gt;(simulé)' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#333333;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1650" y="340" width="170" height="95" as="geometry"/></mxCell><mxCell id="lf" value='&lt;b&gt;&lt;font color="#333333"&gt;Langfuse&lt;/font&gt;&lt;/b&gt;&lt;br&gt;(option)' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#333333;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1650" y="475" width="170" height="85" as="geometry"/></mxCell><mxCell id="hum" value="Superviseur humain" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=none;strokeColor=#333333;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="655" width="40" height="70" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;&lt;font color=&quot;#1f5fa8&quot;&gt;Superviseur méta-agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;LLM · lit, détecte, explique&lt;br&gt;demande l'arrêt, ne décide pas" style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#1f5fa8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="665" width="200" height="85" as="geometry"/></mxCell><mxCell id="tour" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;Tour de contrôle&lt;/font&gt;&lt;/b&gt;&lt;br&gt;fil de discussion · alertes&lt;br&gt;replay · intégrité ✓' style="html=1;whiteSpace=wrap;fillColor=none;fontColor=#333333;fontSize=12;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="665" width="230" height="85" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Trait plein&lt;/b&gt; = chemin de décision · &lt;b&gt;pointillé&lt;/b&gt; = lecture, supervision, export. Le Quorum sollicite les juges (flèches montantes) et reçoit leurs verdicts.&lt;br&gt;&lt;b&gt;Quorum&lt;/b&gt; : 2 votes sur 2 au-dessus de 1 000 € · sinon majorité pondérée &amp;gt; 70 % (poids = Trust Score) · veto, abstention ou montant &amp;gt; 10 000 € ⇒ HITL.&lt;br&gt;&lt;b&gt;Invariants&lt;/b&gt; : aucun agent → agent direct · seule la passerelle touche le marché · ordre ≠ autorisation ⇒ bloqué · tout arrêt est journalisé, la quarantaine n'est levée que par un humain.&lt;br&gt;&lt;b&gt;Conformité&lt;/b&gt; : AI Act art. 12 (journalisation) et 14 (contrôle humain) · MiFID II RTS 6 (kill switch) · DORA (mode dégradé) · principe des 4 yeux." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="810" width="1400" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>