<mxfile host="app.diagrams.net"><diagram name="Agents liens"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ManAgent — Liens entre catégories d'agents (contrats uniquement)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="prop" value="&lt;b&gt;Proposer&lt;/b&gt;&lt;br&gt;LLM génératif&lt;br&gt;n'agit jamais seul" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;Policy Engine&lt;/b&gt;&lt;br&gt;déterministe&lt;br&gt;ALLOW · ESCALATE · BLOCK" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Juge Risque&lt;/b&gt;&lt;br&gt;règles déterministes" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="200" height="90" as="geometry"/></mxCell><mxCell id="comp" value="&lt;b&gt;Juge Conformité&lt;/b&gt;&lt;br&gt;KYC · liste blanche" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="200" height="90" as="geometry"/></mxCell><mxCell id="quo" value="&lt;b&gt;Quorum pondéré&lt;/b&gt;&lt;br&gt;Risque ET Conformité&lt;br&gt;poids = Trust Score" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="910" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="exe" value="&lt;b&gt;Exécuteur&lt;/b&gt;&lt;br&gt;tactique, ne décide pas" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="int" value="&lt;b&gt;Integrity Engine&lt;/b&gt;&lt;br&gt;ordre = autorisation ?" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1490" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="rg" value="&lt;b&gt;Risk Governor&lt;/b&gt;&lt;br&gt;budget · circuit breaker" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1490" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="mkt" value="&lt;b&gt;Marché / paiement&lt;/b&gt;&lt;br&gt;(simulé)" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Superviseur&lt;/b&gt;&lt;br&gt;méta-agent&lt;br&gt;observe, n'exécute pas" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="200" height="90" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Journal d'audit&lt;/b&gt;&lt;br&gt;AuditEvent chaîné" style="rounded=1;fillColor=none;strokeColor=#333333;fontColor=#222222;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="200" height="90" as="geometry"/></mxCell><mxCell id="f1" value="TransactionIntent" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="prop" target="pol"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="demande de vote" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pol" target="risk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="demande de vote" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pol" target="comp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="JudgeVerdict&lt;br&gt;approve / veto / abstain" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="risk" target="quo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="JudgeVerdict" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="comp" target="quo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="Authorization&lt;br&gt;(hash de l'intention)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="quo" target="exe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f7" value="ExecutionOrder" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exe" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f8" value="ordre conforme" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="int" target="rg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f9" value="exécution simulée" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rg" target="mkt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f10" value="lit les AuditEvent" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="sup" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f11" value="kill switch /&lt;br&gt;quarantaine" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="sup" target="rg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="Trait plein = flux de contrats (chemin de décision). Pointillé = supervision (lecture ou arrêt, jamais de vote ni d'exécution). Les agents ne s'appellent pas directement : ils échangent uniquement des modèles Pydantic." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1360" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>